# Template only — for documentation. The build does NOT read this file; it reads
# the equivalent values from environment variables (see the comment at the top of
# app/build.gradle.kts). CI fills those variables from four repository secrets,
# which is where the real values live:
#
#   GitHub secret        ->  env var / meaning
#   KEYSTORE_BASE64      ->  KEYSTORE_FILE (base64 of the PKCS#12, decoded to a file)
#   KEYSTORE_PASSWORD    ->  KEYSTORE_PASSWORD (store password)
#   KEY_ALIAS            ->  KEY_ALIAS (key alias)
#   KEY_PASSWORD         ->  KEY_PASSWORD (key password)
#
# The values themselves are never committed: the keystore and its password stay
# in GitHub Secrets and on the release machine only. Do not paste real secrets
# into this file, and never commit a filled-in copy.
storeFile=/absolute/path/to/lovenest-release.p12
storePassword=PLACEHOLDER
keyAlias=lovenest
keyPassword=PLACEHOLDER

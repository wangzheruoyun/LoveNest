<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      MANAGE_EXTERNAL_STORAGE is the one the runtime flow in MainActivity asks
      for (Android 11+). It is what lets the app read the user's own game folder
      in place, and the human partner explicitly declined a SAF fallback.
      SET_WALLPAPER is a normal permission and needs no runtime prompt (§5.6).
      VIBRATE backs the Meta performance's vibration (no runtime prompt either).
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      On the 8.0-10 range that minSdk 26 claims, the same reach over /sdcard is
      the legacy runtime grant instead. Capped at 29 so they never appear on the
      target device (Android 14) or trigger the "all files access" workflow.
      No INTERNET permission: the game's startup network calls are meant to fail
      offline (design §7 risk 6).
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
      The launcher icon is the demo's own 爱之巢 character artwork, copied in as
      the plan's Task 10 Step 1 explicitly allows (the single, deliberate
      exception to "the repo holds no game resources"). Source:
      asset/image/icon/图标.png (512x512 RGBA). The shipped file is malformed -
      its PNG signature bytes are transposed and it contains one spurious byte -
      so the committed copy carries those two byte-level repairs (a copy only;
      the game folder itself is untouched). No resize or re-encode was done and
      no image tooling was involved: the repaired file is the original pixel
      data, proven by every chunk CRC validating and the IDAT stream inflating
      to exactly 512x512x4 plus filter bytes. See task-10-report.md.
    -->
    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Backs GameBridge.openFile() (nw.Shell.openItem -> a system Intent). On API
          24+ a file:// URI cannot be handed to another app, so the URI has to be a
          content:// one; file_paths.xml confines the provider to the game root and
          the documents root, nothing else. No INTERNET permission is involved.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

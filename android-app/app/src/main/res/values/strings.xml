<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Task 10: the launcher label the user sees. -->
    <string name="app_name">爱之巢</string>

    <!--
      Gate screens. The app cannot run the game without "all files access" (to
      read the user's own game folder in place) and without the folder itself, so
      both cases are explained on screen rather than white-screening.
    -->
    <string name="gate_permission_title">需要“所有文件访问”权限</string>
    <string name="gate_permission_message">《爱之巢》需要直接读取手机上的游戏文件夹，请授予“所有文件访问”权限，然后返回本应用，会自动继续。</string>
    <string name="gate_permission_button">打开权限设置</string>
    <string name="gate_missing_title">未找到游戏文件夹</string>
    <string name="gate_missing_message">请把《爱之巢》Demo 文件夹放到：\n%1$s\n该文件夹里应当有 index.html。放好后点击下面的按钮重新检查。</string>
    <string name="gate_missing_button">重新检查</string>
    <string name="gate_settings_unavailable">无法打开权限设置页面，请到系统设置中手动授予“所有文件访问”权限。</string>

    <!-- Ruling D: a silent platform-3 fallback is the worst outcome of the port. -->
    <string name="bridge_missing">警告：游戏兼容层没有生效（%1$s），Meta 演出与文件存档已失效。游戏仍可运行，但结果不完整。</string>

    <!--
      Back button (Task 10 Step 2). The system back gesture is handed to the
      in-game UI first (a synthetic Escape), then this confirms before the
      activity is finished, so a running game with unsaved state is never
      silently killed.
    -->
    <string name="exit_confirm_title">确定要退出吗？</string>
    <string name="exit_confirm_message">确定要退出《爱之巢》吗？未保存的进度可能会丢失。</string>
    <string name="exit_confirm_exit">退出</string>
    <string name="exit_confirm_cancel">取消</string>

    <!--
      Task 12 diagnostic build: the back key opens a menu instead of the plain
      exit confirm. The dump and the context-loss simulation used to live on the
      volume keys; the keys are handed back to the platform, and these
      instruments are reached from here. All of it goes away with the
      diagnostic switch (see SHOW_DIAG_MENU).
    -->
    <string name="back_menu_title">爱之巢 · 诊断菜单</string>
    <string name="back_menu_message">选择要执行的操作。「退出游戏」会丢失未保存的进度。</string>
    <string name="back_menu_dump">写入诊断 dump</string>
    <string name="back_menu_context_loss">模拟渲染上下文丢失（画面会短暂变黑）</string>
    <string name="back_menu_exit">退出游戏</string>

    <!--
      Task 11: the renderer-death verdict. Reported for the diagnostic run; it
      is also the only in-app recovery from a dead renderer, which is otherwise
      a permanently black screen until the app is killed.
    -->
    <string name="renderer_gone_title">渲染进程已崩溃 / renderer process died</string>
    <string name="renderer_gone_message">游戏的渲染进程已崩溃，画面因此变黑。诊断日志已保存。\n\nThe renderer process died, which is why the screen is black. A diagnostic log has been saved. Reload to continue playing.</string>
    <string name="renderer_gone_reload">重新加载</string>
</resources>
